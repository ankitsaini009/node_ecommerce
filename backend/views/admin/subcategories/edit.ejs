<%- include("../layouts/header") %>
<%- include("../layouts/sidebar") %>

<div class="content-body">
  <div class="container-fluid">
    <div class="d-flex align-items-center mb-4">
      <h4 class="fs-20 font-w600 mb-0 me-auto">Edit Sub Category</h4>
      <a href="/admin/subcategories" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left me-2"></i>Back to Sub Categories
      </a>
    </div>

    <% if (message && message.length > 0) { %>
      <div class="alert alert-success alert-dismissible fade show">
        <strong>Success!</strong> <%= message[0] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <% if (error && error.length > 0) { %>
      <div class="alert alert-danger alert-dismissible fade show">
        <strong>Error!</strong> <%= error[0] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="row">
      <div class="col-xl-12">
        <div class="card">
          <div class="card-body">
            <form id="subcategoryForm" action="/admin/subcategories-edit/<%= subcategory.id %>" method="POST" enctype="multipart/form-data">
              
              <div class="row">
                <div class="col-md-6 mb-4">
                  <label class="form-label font-w600">Sub Category Name *</label>
                  <input type="text" name="name" class="form-control solid" value="<%= subcategory.name %>" required>
                </div>

                <div class="col-md-6 mb-4">
                  <label class="form-label font-w600">Parent Category *</label>
                  <select name="category_id" class="form-control solid" required>
                    <option value="">Select Category</option>
                    <% if (categories && categories.length > 0) { %>
                      <% categories.forEach(category => { %>
                        <option value="<%= category.id %>" <%= subcategory.category_id == category.id ? 'selected' : '' %>>
                          <%= category.name %>
                        </option>
                      <% }) %>
                    <% } %>
                  </select>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6 mb-4">
                  <label class="form-label font-w600">Slug</label>
                  <input type="text" name="slug" class="form-control solid" value="<%= subcategory.slug %>">
                  <small class="text-muted">Leave blank for auto-generation</small>
                </div>

                <div class="col-md-6 mb-4">
                  <label class="form-label font-w600">Status *</label>
                  <select name="status" class="form-control solid" required>
                    <option value="active" <%= subcategory.status === 'active' ? 'selected' : '' %>>Active</option>
                    <option value="inactive" <%= subcategory.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                  </select>
                </div>
              </div>

              <div class="row">
                <div class="col-md-12 mb-4">
                  <label class="form-label font-w600">Sub Category Image</label>
                  <input type="file" name="image" class="form-control solid" accept="image/*">
                  <% if (subcategory.image) { %>
                    <div class="mt-2">
                      <img src="/uploads/<%= subcategory.image %>" alt="Current Image" style="max-height: 100px;">
                    </div>
                  <% } %>
                </div>
              </div>

              <div class="row">
                <div class="col-md-12 mb-4">
                  <label class="form-label font-w600">Description</label>
                  <textarea name="description" rows="4" class="form-control solid"><%= subcategory.description || '' %></textarea>
                </div>
              </div>

              <h5 class="mb-3">SEO Information</h5>
              
              <div class="row">
                <div class="col-md-12 mb-4">
                  <label class="form-label font-w600">Meta Title</label>
                  <input type="text" name="meta_title" class="form-control solid" value="<%= subcategory.meta_title || '' %>">
                </div>
              </div>

              <div class="row">
                <div class="col-md-12 mb-4">
                  <label class="form-label font-w600">Meta Description</label>
                  <textarea name="meta_description" rows="3" class="form-control solid"><%= subcategory.meta_description || '' %></textarea>
                </div>
              </div>

            </form>
          </div>

          <div class="card-footer text-end">
            <a href="/admin/subcategories" class="btn btn-secondary me-2">Cancel</a>
            <button type="submit" form="subcategoryForm" class="btn btn-primary">
              <i class="fas fa-save me-2"></i>Update Sub Category
            </button>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<%- include("../layouts/footer") %>
