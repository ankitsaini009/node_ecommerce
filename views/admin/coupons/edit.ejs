<%- include("../layouts/header") %>
<%- include("../layouts/sidebar") %>

<div class="content-body">
  <div class="container-fluid">
    <div class="d-flex align-items-center mb-4">
      <h4 class="fs-20 font-w600 mb-0 me-auto">Edit Coupon</h4>
      <a href="/admin/coupons" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left me-2"></i>Back to Coupons
      </a>
    </div>

    <% if (error && error.length > 0) { %>
      <div class="alert alert-danger alert-dismissible fade show">
        <strong>Error!</strong> <%= error[0] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="row">
      <div class="col-xl-12">
        <div class="card">
          <div class="card-body">
            <form id="couponForm" action="/admin/coupons-edit/<%= coupon.id %>" method="POST">
              
              <div class="row">
                <div class="col-md-6 mb-4">
                  <label class="form-label font-w600">Coupon Code *</label>
                  <input type="text" name="code" class="form-control solid" value="<%= coupon.code %>" required style="text-transform: uppercase;">
                </div>

                <div class="col-md-6 mb-4">
                  <label class="form-label font-w600">Status *</label>
                  <select name="status" class="form-control solid" required>
                    <option value="active" <%= coupon.status === 'active' ? 'selected' : '' %>>Active</option>
                    <option value="inactive" <%= coupon.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                  </select>
                </div>
              </div>

              <div class="row">
                <div class="col-md-12 mb-4">
                  <label class="form-label font-w600">Description</label>
                  <textarea name="description" rows="3" class="form-control solid"><%= coupon.description || '' %></textarea>
                </div>
              </div>

              <h5 class="mb-3">Discount Details</h5>

              <div class="row">
                <div class="col-md-6 mb-4">
                  <label class="form-label font-w600">Discount Type *</label>
                  <select name="discount_type" class="form-control solid" required>
                    <option value="fixed" <%= coupon.discount_type === 'fixed' ? 'selected' : '' %>>Fixed Amount ($)</option>
                    <option value="percent" <%= coupon.discount_type === 'percent' ? 'selected' : '' %>>Percentage (%)</option>
                  </select>
                </div>

                <div class="col-md-6 mb-4">
                  <label class="form-label font-w600">Discount Value *</label>
                  <input type="number" name="discount_value" class="form-control solid" step="0.01" value="<%= parseFloat(coupon.discount_value).toFixed(2) %>" required>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6 mb-4">
                  <label class="form-label font-w600">Minimum Purchase Amount</label>
                  <input type="number" name="min_purchase" class="form-control solid" step="0.01" value="<%= parseFloat(coupon.min_purchase).toFixed(2) %>">
                </div>

                <div class="col-md-6 mb-4">
                  <label class="form-label font-w600">Maximum Discount Amount</label>
                  <input type="number" name="max_discount" class="form-control solid" step="0.01" value="<%= coupon.max_discount ? parseFloat(coupon.max_discount).toFixed(2) : '' %>">
                </div>
              </div>

              <h5 class="mb-3">Usage Limits</h5>

              <div class="row">
                <div class="col-md-6 mb-4">
                  <label class="form-label font-w600">Total Usage Limit</label>
                  <input type="number" name="usage_limit" class="form-control solid" value="<%= coupon.usage_limit || '' %>">
                </div>

                <div class="col-md-6 mb-4">
                  <label class="form-label font-w600">Per User Limit</label>
                  <input type="number" name="per_user_limit" class="form-control solid" value="<%= coupon.per_user_limit %>">
                </div>
              </div>

              <h5 class="mb-3">Validity Period</h5>

              <div class="row">
                <div class="col-md-6 mb-4">
                  <label class="form-label font-w600">Valid From *</label>
                  <input type="datetime-local" name="valid_from" class="form-control solid" 
                    value="<%= new Date(coupon.valid_from).toISOString().slice(0, 16) %>" required>
                </div>

                <div class="col-md-6 mb-4">
                  <label class="form-label font-w600">Valid Till *</label>
                  <input type="datetime-local" name="valid_to" class="form-control solid" 
                    value="<%= new Date(coupon.valid_to).toISOString().slice(0, 16) %>" required>
                </div>
              </div>

            </form>
          </div>

          <div class="card-footer text-end">
            <a href="/admin/coupons" class="btn btn-secondary me-2">Cancel</a>
            <button type="submit" form="couponForm" class="btn btn-primary">
              <i class="fas fa-save me-2"></i>Update Coupon
            </button>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<%- include("../layouts/footer") %>
